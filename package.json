{
  "name": "ghost-dreadnought",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "server": "node server/server.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && NODE_ENV=production node server/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.56.1",
    "@types/three": "0.170.0",
    "meshoptimizer": "^0.22.0",
    "sharp": "^0.34.3",
    "typescript": "5.6.3",
    "vite": "6.3.5",
    "vitest": "3.1.4"
  }
}
